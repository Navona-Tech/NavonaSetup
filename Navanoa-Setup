# Global scripts directory
nvscripts_dir = "~/navona-scripts"
gitkeyname = "github-navona-tech"
github_account = "Navona-Tech"
github_remote = "github"
scripts_repo = "navona-scripts"
setup_repo = "NavonaSetup"

# GitHub access over HTTPS (PAT authentication)
github_https_base = "https://github.com/"
github_credentials_file = "~/.git-credentials"
# SSH url forms that are rewritten to HTTPS when working with a PAT, so that repositories
# and scripts that hardcode the SSH host alias (nvgitinit, mkgithub.sh, existing clones)
# keep working without any change.
ssh_url_prefixes = [
    f"git@{gitkeyname}:",
    f"ssh://git@{gitkeyname}/",
    "git@github.com:",
    "ssh://git@github.com/",
]

# Authentication methods
auth_pat = "pat"
auth_ssh = "ssh"


class NvConfigs:
    vars: dict[str, tuple[str, str, str, Any]] = {
        "user.name": ("Your full name", "user", "name", ""),
        "user.email": ("Your email address", "user", "email", ""),
        "core.editor": ("Your preferred text editor", "core", "editor", "vim"),
        "init.defaultbranch": ("Default branch name", "init", "defaultBranch", "main"),
        "merge.branchdesc": ("Show branch description in merge commit messages", "merge", "branchdesc", "true"),
        "github.user": ("Your GitHub username", "github", "user", ""),
        "github.account": ("Your GitHub account name", "github", "account", github_account),
        "core.hookspath": ("Path to your the global git hooks", "core", "hooksPath", f"{nvscripts_dir}/githooks"),
        "push.autoSetupRemote": ("Create branches on remote by default", "push", "autoSetupRemote", "true"),
        # "remote.github.fetch": (
        #    "Fetch all remote branches",
        #    'remote "github"',
        #    "fetch",
        #    "+refs/heads/*:refs/remotes/github/*",
        # ),
        # "test.value": ("Test value", "test", "value", "gogo"),
    }

    def __init__(self):
        global_config_path = os.path.expanduser("~/.gitconfig")
        self.config = GitConfigParser(global_config_path, read_only=False)
        self.values = {}
        for var in self.vars:
            current_value = self.GetConfig(var)
            self.values[var] = current_value

    def GetConfig(self, var) -> int | float | str | bool | None:
        """Get current global git configuration values."""
        if not var in self.vars:
            raise ValueError(f"Invalid variable: {var}")
        return self.config.get_value(self.vars[var][1], self.vars[var][2], "")

    def Prompt(self, var: str, current_value: Any = None) -> str:
        """Prompt user for a git config value."""
        if current_value == None or current_value == "":
            prompt = f"[Missing] Enter a value for '{var}' [{self.vars[var][3]}]: "
        else:
            prompt = f"[Update] Enter a value to update '{var}' [{current_value}]: "
        return input(prompt).strip()

    def Update(self, force: bool = False, force_vars: dict[str, Any] | None = None) -> bool:
        updated = False
        if force_vars == None:
            force_vars = {}
        for var in self.vars:
            current_value = self.GetConfig(var) if var not in force_vars else force_vars[var]
            if not current_value or force or var in force_vars:
                v = self.Prompt(var, current_value)
                if not v:
                    v = current_value if current_value else self.GetDefault(var)
                if v != self.GetConfig(var):
                    updated = True
                self.values[var] = v
        return updated

    def SetDefault(self, var: str, value: Any):
        record = self.vars.get(var, None)
        assert record is not None, f"Invalid variable: {var}"
        self.vars[var] = (record[0], record[1], record[2], value)

    def GetDefault(self, var: str) -> Any:
        return self.vars[var][3]

    def Show(self, title: str):
        print("### ", title)
        for var in self.vars:
            print(f"\t{var}: {self.values[var]}")

    def YesNo(self, prompt: str, def_input: bool = False) -> bool:
        if def_input:
            prompt = prompt + " [Y/n]: "
        else:
            prompt = prompt + " [y/N]: "
        while True:
            user_input = input("### " + prompt).strip()
            if user_input == "y" or user_input == "Y" or (user_input == "" and def_input == True):
                return True
            elif user_input == "n" or user_input == "N" or (user_input == "" and def_input == False):
                return False
            else:
                print("### Invalid input, please enter y or n")

    def Save(self, force: bool = False):
        for var in self.vars:
            if self.values[var]:
                self.config.set_value(self.vars[var][1], self.vars[var][2], self.values[var])
        self.Release()

    def Release(self):
        """Flush and unlock ~/.gitconfig.

        GitConfigParser holds a ~/.gitconfig.lock while it is open for writing, which makes
        every 'git config --global ...' call fail. It must be released before any git command
        that writes the global configuration is invoked. Releasing twice is harmless, and the
        already parsed values remain readable afterwards.
        """
        self.config.release()


def RunGit(args: List[str], quiet: bool = False) -> int:
    """Run a git command, returning its exit code (never prompts for credentials)."""
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    out = subprocess.DEVNULL if quiet else None
    return subprocess.call(["git"] + args, env=env, stdout=out, stderr=out)


def GitConfigGet(key: str) -> str:
    """Read a single global git config value ('' when unset)."""
    res = subprocess.run(["git", "config", "--global", "--get", key], capture_output=True, text=True)
    return res.stdout.strip() if res.returncode == 0 else ""


def GitConfigSet(key: str, value: str) -> bool:
    if RunGit(["config", "--global", key, value]) != 0:
        print(f"### Error: failed to set git config {key}", file=sys.stderr)
        return False
    return True


def GitConfigUnsetAll(key: str):
    """Unset a (possibly multi-valued) global git config key, ignoring 'not set' errors."""
    RunGit(["config", "--global", "--unset-all", key], quiet=True)


def GetAuthMethod(nv_configs: NvConfigs, args: argparse.Namespace) -> str:
    """Resolve the GitHub authentication method: explicit flag, stored choice, or ask."""
    if args.pat and args.ssh:
        print("### Error: --pat and --ssh are mutually exclusive.", file=sys.stderr)
        exit(1)
    if args.pat:
        method = auth_pat
    elif args.ssh:
        method = auth_ssh
    else:
        method = GitConfigGet("github.authmethod")
        if method not in (auth_pat, auth_ssh):
            # No stored choice: infer from what is already configured, otherwise ask.
            if HasPatCredentials():
                method = auth_pat
            elif os.path.exists(os.path.expanduser(f"~/.ssh/{gitkeyname}")):
                method = auth_ssh
            else:
                method = (
                    auth_pat
                    if nv_configs.YesNo(
                        "Use a GitHub Personal Access Token over HTTPS? (answer 'n' for an SSH key)", def_input=True
                    )
                    else auth_ssh
                )
    GitConfigSet("github.authmethod", method)
    print(f"### GitHub authentication method: {method}")
    return method


def HasPatCredentials() -> bool:
    """True when a github.com entry already exists in the git credentials store."""
    credentials_file = os.path.expanduser(github_credentials_file)
    if not os.path.exists(credentials_file):
        return False
    with open(credentials_file, "r") as f:
        return any("@github.com" in line for line in f)


def RepoUrl(repo: str, gitaccount: str, use_pat: bool) -> str:
    """Build the clone url for a repository of the GitHub account."""
    if use_pat:
        return f"{github_https_base}{gitaccount}/{repo}.git"
    return f"git@{gitkeyname}:{gitaccount}/{repo}.git"


def SetupSshKey(nv_configs: NvConfigs):
    # Generate ssh key
    email = nv_configs.GetConfig("user.email")
    ssh_dir = os.path.expanduser("~/.ssh")
    ssh_keyfile = os.path.join(ssh_dir, gitkeyname)
    ssh_config_file = os.path.join(ssh_dir, "config")
    os.system(f"ssh-keygen -C '{email}' -f {ssh_keyfile}")
    backup_file = os.path.join(ssh_dir, f"config.{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}")
    os.system(f"cp {ssh_config_file} {backup_file}")
    with open(ssh_config_file, "a") as f:
        f.write(
            f"\nHost {gitkeyname}\n  HostName github.com\n  User git\n  IdentityFile {ssh_keyfile}\n  IdentitiesOnly yes\n"
        )
    os.chmod(ssh_config_file, 0o600)
    print(f"### Created ssh key {gitkeyname}, original config saved to {backup_file}")
    # Print out the public key and ask the user to add it to the github account deploy keys with write perm
    print(f"### Public key: {ssh_keyfile}.pub")
    print(f"### Add the following key to the {github_account} deploy keys with write perm!")
    with open(ssh_keyfile + ".pub", "r") as f:
        print(f"{f.read()}")

    if nv_configs.YesNo(f"Did you add the key to the {github_account} deploy keys with write perm?"):
        print(f"### Good, continuing with setup...")
    else:
        print(f"### Aborting... Can't continue")
        exit(1)


def ConfigureHttpsRewrites():
    """Make git use HTTPS (with the PAT) for every SSH-style GitHub url.

    The nv* scripts and existing clones use the 'git@github-navona-tech:' host alias. Rewriting
    it to HTTPS means every repository - navona-scripts, NavonaSetup and any project repo -
    is accessed with the PAT, without touching a single remote.
    """
    key = f"url.{github_https_base}.insteadOf"
    GitConfigUnsetAll(key)
    for prefix in ssh_url_prefixes:
        RunGit(["config", "--global", "--add", key, prefix])
    print(f"### Configured git to use {github_https_base} instead of: {', '.join(ssh_url_prefixes)}")


def RemoveHttpsRewrites():
    """Drop the HTTPS url rewrites so that SSH urls are used as-is again."""
    key = f"url.{github_https_base}.insteadOf"
    if GitConfigGet(key):
        GitConfigUnsetAll(key)
        print(f"### Removed the HTTPS url rewrites (SSH urls are used as-is)")


def VerifyGitHubAccess(gitaccount: str, repos: List[str]) -> bool:
    """Check that the configured credentials give access to the given repositories."""
    ok = True
    for repo in repos:
        url = f"{github_https_base}{gitaccount}/{repo}.git"
        if RunGit(["ls-remote", url, "HEAD"], quiet=True) != 0:
            print(f"### Error: could not access {gitaccount}/{repo} over HTTPS.")
            ok = False
        else:
            print(f"### Access to {gitaccount}/{repo} confirmed.")
    return ok


def SetupPatToken(nv_configs: NvConfigs, gitaccount: str) -> str:
    """Guide the user to create a GitHub Personal Access Token and configure git to use it."""
    print("""
### ---- GitHub Personal Access Token Setup ----
###
### To generate a fine-grained Personal Access Token:
###
###  1. Go to https://github.com/settings/tokens?type=beta
###  2. Click "Generate new token"
###  3. Set a descriptive name (e.g., "navona-dev-machine")
###  4. Set expiration as needed (recommended: 90 days or more)
###  5. Under "Resource owner", select "{account}"
###  6. Under "Repository access", select "All repositories"
###     (or "Only select repositories" and pick "{scripts}", "{setup}"
###      and every repository you are going to work on)
###  7. Under "Permissions" -> "Repository permissions", grant:
###     - Contents: Read and write
###     - Metadata: Read-only (auto-selected)
###
### Required access levels:
###   - "{scripts}" and "{setup}": at least READ access (Contents: Read-only)
###     -> they are only cloned/pulled by this setup and by the nv* scripts
###   - any additional repository you want to work on: READ AND WRITE access
###     (Contents: Read and write) -> needed to push branches, commit and release
###
###  8. Click "Generate token" and copy the token
###
### The token may also be passed in the GITHUB_TOKEN environment variable.
### -----------------------------------------------""".format(account=gitaccount, scripts=scripts_repo, setup=setup_repo),
        flush=True,
    )

    env_token = os.environ.get("GITHUB_TOKEN", "").strip()
    while True:
        token = ""
        if env_token:
            if nv_configs.YesNo("Use the token found in the GITHUB_TOKEN environment variable?", def_input=True):
                print("### Using the token from GITHUB_TOKEN")
                token = env_token
            env_token = ""  # only offer it once
        if not token:
            token = getpass.getpass("### Paste your Personal Access Token (input is hidden): ").strip()
        if not token:
            print("### Error: No token provided. Aborting.")
            exit(1)

        StorePatToken(nv_configs, token)
        ConfigureHttpsRewrites()
        SetupGhCli(nv_configs, token)

        # Verify the token gives access to the repositories the workflow depends on
        print("### Verifying token access to GitHub...")
        if VerifyGitHubAccess(gitaccount, [scripts_repo, setup_repo]):
            return token

        print("### The token is invalid, expired, or was not granted access to the repositories above.")
        print("### Note: git drops a rejected token from the credentials store, so it must be entered again.")
        if nv_configs.YesNo("Enter another Personal Access Token?", def_input=True):
            continue
        if not nv_configs.YesNo("Continue anyway?"):
            exit(1)
        return token


def StorePatToken(nv_configs: NvConfigs, token: str):
    """Save the token in the git credentials store and enable the 'store' credential helper."""
    credentials_file = os.path.expanduser(github_credentials_file)
    gituser = nv_configs.values.get("github.user") or GitConfigGet("github.user") or "x-access-token"
    # The user/token are part of a url, so they must be percent encoded
    credential_entry = (
        f"https://{urllib.parse.quote(str(gituser), safe='')}:{urllib.parse.quote(token, safe='')}@github.com"
    )

    # Read existing credentials and check if there's already an entry for github.com
    existing_lines = []
    if os.path.exists(credentials_file):
        with open(credentials_file, "r") as f:
            existing_lines = f.readlines()

    # Replace any existing github.com entry, or append the new one
    updated = False
    new_lines = []
    for line in existing_lines:
        if "github.com" in line:
            if not updated:
                new_lines.append(credential_entry + "\n")
                updated = True
        else:
            new_lines.append(line)
    if not updated:
        new_lines.append(credential_entry + "\n")

    with open(credentials_file, "w") as f:
        f.writelines(new_lines)
    os.chmod(credentials_file, 0o600)

    # Set git credential helper to store (fails if ~/.gitconfig is still locked, see NvConfigs.Release)
    GitConfigSet("credential.helper", "store")
    print(f"### Token saved to {credentials_file} and credential helper configured.")


def SetupGhCli(nv_configs: NvConfigs, token: str):
    """Authenticate the gh CLI with the same token (gh is used by the nv* scripts)."""
    if not shutil.which("gh"):
        return
    if not nv_configs.YesNo("Authenticate the gh CLI with this token?", def_input=True):
        return
    res = subprocess.run(["gh", "auth", "login", "--with-token"], input=token + "\n", text=True)
    if res.returncode != 0:
        print("## Warning: 'gh auth login' failed. Run it manually: gh auth login")
        return
    print("### gh CLI authenticated")


def CloneScriptsRepository(scripts_dir: str, gitaccount: str, use_pat: bool = False):
    # clone the nvscripts repository under the scripts_dir
    repo_url = RepoUrl(scripts_repo, gitaccount, use_pat)
    print(f"### git clone {repo_url} --origin {github_remote} {scripts_dir}")
    if RunGit(["clone", repo_url, "--origin", github_remote, scripts_dir]) != 0:
        print(f"### Error: Failed to clone {scripts_repo} under {scripts_dir}", file=sys.stderr)
        if use_pat:
            print(
                f"###        Make sure your token has at least read access to {gitaccount}/{scripts_repo}"
                f" and re-run the setup with -u to enter a new one.",
                file=sys.stderr,
            )
        else:
            print(f"###        Make sure the {gitkeyname} ssh key is registered on GitHub.", file=sys.stderr)
        exit(1)

    print(f"### Cloned nvscripts repository under {scripts_dir}")
    # Ensure scripts_dir is in the path, if not add it to the bashrc
    if scripts_dir not in os.environ["PATH"]:
        with open(os.path.expanduser("~/.bashrc"), "a") as f:
            ret = f.write(f"\n# nvScripts: Add {scripts_dir} to the path\nexport PATH={scripts_dir}:$PATH\n")
            if ret <= 0:
                raise Exception(f"### Failed to add {scripts_dir} to the path")
    print(f"### Added {scripts_dir} to the path")


def CreateBinDirectory(bin_dir: str):
    if not os.path.exists(bin_dir):
        os.makedirs(bin_dir)
        print(f"### Created {bin_dir} directory")
    if bin_dir not in os.environ["PATH"]:
        with open(os.path.expanduser("~/.bashrc"), "a") as f:
            ret = f.write(f"\n# nvScripts: Add {bin_dir} to the path\nexport PATH={bin_dir}:$PATH\n")
            if ret <= 0:
                raise Exception(f"### Failed to add {bin_dir} to the path")
    print(f"### Added {bin_dir} to the path")

def UpdatePromptWithGitBranch(nv_configs: NvConfigs):
    prompt = r'''# Git Branch Prompt - By NavonaSetup
if [ -z "$NVSetupPrompt" ]; then
	NVSetupPrompt="yes"
	parse_git_branch() {
     		git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1)/'
	}
	export PS1="\u@\h: \[\e[32m\]\w \[\e[91m\]\$(parse_git_branch)\[\e[00m\]$ "
fi
'''
    # Check if the prompt is already in the .bashrc
    with open(os.path.expanduser("~/.bashrc"), "r") as f:
        if "NVSetupPrompt" in f.read():
            print(f"### Prompt with git branch already exists in .bashrc")
            return

    # Add the prompt to the .bashrc
    with open(os.path.expanduser("~/.bashrc"), "a") as f:
        f.write(prompt)
    print(f"### Added prompt with git branch to .bashrc")

def UpdateConfig(update: bool) -> NvConfigs:
    nv_configs = NvConfigs()
    nv_configs.Show("Current configuration")
    print("\n### Completing/Updating configuration...\n")
    if nv_configs.Update(update):
        nv_configs.Show("Updated configuration")
        if nv_configs.YesNo("Save configuration?", def_input=True):
            nv_configs.Save()
        else:
            print("\n### Abort changes.\n")
    else:
        print("### No changes has been made.\n")
    return nv_configs


def InstallClaudeFiles(scripts_dir: str):
    """Install Claude-related files (skills, plugins, etc.) from navona-scripts to ~/.claude/."""
    claude_src = os.path.join(scripts_dir, "claude")
    claude_dst = os.path.expanduser("~/.claude")

    if not os.path.isdir(claude_src):
        print(f"### No claude directory found in {scripts_dir}, skipping")
        return

    # Walk the source claude directory and copy all files, preserving subdirectory structure
    for dirpath, dirnames, filenames in os.walk(claude_src):
        for filename in filenames:
            src_file = os.path.join(dirpath, filename)
            rel_path = os.path.relpath(src_file, claude_src)
            dst_file = os.path.join(claude_dst, rel_path)
            dst_dir = os.path.dirname(dst_file)
            if not os.path.exists(dst_dir):
                os.makedirs(dst_dir)
            shutil.copy2(src_file, dst_file)
            print(f"###   Installed {rel_path}")

    print(f"### Claude files installed from {claude_src} to {claude_dst}")


def CheckConfig(nv_configs: NvConfigs) -> Dict[str, Any]:
    # Check that the git user ends with "-navona". If not, ask to update the configuration
    missing_vars = {}
    for var in nv_configs.vars:
        value = nv_configs.GetConfig(var)
        if not value:
            print(f"### Error: mandatory {var} is missing.")
            missing_vars[var] = nv_configs.GetDefault(var)

    gituser = nv_configs.GetConfig("github.user")
    user = nv_configs.GetConfig("user.name")
    assert isinstance(user, str)
    assert isinstance(gituser, str)
    if not gituser.endswith("-navona") and user:
        suggested_gituser = user.lower().replace(" ", "") + "-navona"
        print(f"### Error: git user {gituser} does not end with '-navona'!. Suggested name: {suggested_gituser}")
        missing_vars["github.user"] = suggested_gituser
    return missing_vars


def CheckRequiredTools():
    """Check that required CLI tools are installed."""
    required = [("git", "sudo apt install git")]
    missing = []
    for tool, install_hint in required:
        if not shutil.which(tool):
            missing.append((tool, install_hint))
    if missing:
        print("### Error: The following required tools are not installed:", file=sys.stderr)
        for tool, hint in missing:
            print(f"###   {tool} - install with: {hint}", file=sys.stderr)
        exit(1)


def EnsureGhInstalled(nv_configs: NvConfigs) -> bool:
    """Make sure the gh CLI is available, offering to install it when it is missing."""
    if shutil.which("gh"):
        print(f"### gh CLI is installed ({shutil.which('gh')})")
        return True

    print("### The gh CLI (GitHub command line tool) is required but not installed.")
    if nv_configs.YesNo("Install it now with 'sudo apt install gh'?", def_input=True):
        ret = os.system("sudo apt-get update && sudo apt-get install -y gh")
        if ret == 0 and shutil.which("gh"):
            print(f"### Installed gh CLI ({shutil.which('gh')})")
            return True
        print("## Warning: failed to install gh from the distribution packages.")
        print("##          Install it manually, see https://github.com/cli/cli/blob/trunk/docs/install_linux.md")

    if not nv_configs.YesNo("Continue the setup without the gh CLI?", def_input=False):
        print("### Aborting... install gh and re-run the setup.")
        exit(1)
    print("## Warning: continuing without the gh CLI")
    return False


def main():
    parser = argparse.ArgumentParser(description="Setup git global configuration")
    parser.add_argument("-u", "--update", action="store_true", help="Update existing configuration values")
    parser.add_argument(
        "--pat",
        action="store_true",
        help="Use a GitHub Personal Access Token over HTTPS (default when nothing is configured yet)",
    )
    parser.add_argument(
        "--ssh",
        action="store_true",
        help="Use an SSH key for GitHub authentication instead of a PAT",
    )
    args = parser.parse_args()

    CheckRequiredTools()

    try:
        # First Init/Update the configuration
        nv_configs = UpdateConfig(args.update)

        # Check that the configuration is complete and valide
        while missing_vars := CheckConfig(nv_configs):
            if nv_configs.YesNo(f"\nUpdate the configuration to fix?", def_input=True):
                if nv_configs.Update(force_vars=missing_vars):
                    if nv_configs.YesNo("Save configuration?", def_input=True):
                        nv_configs.Save()
                    else:
                        print("\n### Abort changes.\n")
                        exit(1)

        print("### Configuration is valid. Continuing with setup...")

        # Release the ~/.gitconfig lock: from here on the setup runs git commands that write
        # the global configuration, and they fail while GitPython holds the lock.
        nv_configs.Release()

        gitaccount = nv_configs.GetConfig("github.account")
        assert isinstance(gitaccount, str) and gitaccount != "", f"github.account is not set/bad {gitaccount}"

        # Check if ~/bin exists, if not create it, anyhow check that it is in the path
        bin_dir = os.path.expanduser("~/bin")
        if not os.path.exists(bin_dir):
            if nv_configs.YesNo(f"Create ~/bin directory and add it to the path?", def_input=True):
                CreateBinDirectory(bin_dir)

        # The gh CLI is used by the nv* scripts (and to authenticate with the PAT)
        EnsureGhInstalled(nv_configs)

        # Setup GitHub authentication (PAT over HTTPS or SSH key)
        use_pat = GetAuthMethod(nv_configs, args) == auth_pat
        if use_pat:
            # Re-use the stored token unless it is missing, invalid, or an update was requested
            if HasPatCredentials() and not args.update:
                ConfigureHttpsRewrites()
                print("### A GitHub token is already stored, verifying it...")
                if VerifyGitHubAccess(gitaccount, [scripts_repo, setup_repo]):
                    print("### Stored token is valid (use -u to replace it)")
                elif nv_configs.YesNo("Setup a new Personal Access Token (PAT) for GitHub?", def_input=True):
                    SetupPatToken(nv_configs, gitaccount)
            elif nv_configs.YesNo("Setup a Personal Access Token (PAT) for GitHub?", def_input=True):
                SetupPatToken(nv_configs, gitaccount)
        else:
            # SSH urls must not be rewritten to HTTPS when authenticating with a key
            RemoveHttpsRewrites()
            if not os.path.exists(os.path.expanduser(f"~/.ssh/{gitkeyname}")):
                if nv_configs.YesNo(f"Create ssh key {gitkeyname}?", def_input=True):
                    SetupSshKey(nv_configs)
                    print(f"### Created ssh key {gitkeyname}, added to ssh config")
            else:
                print(f"### SSH key {gitkeyname} already exists")

        # Create global navona scripts directory if it doesn't exist
        scripts_dir = os.path.expanduser(nvscripts_dir)
        if not os.path.isdir(os.path.join(scripts_dir, ".git")):
            if os.path.exists(scripts_dir):
                print(f"## Warning: {scripts_dir} exists but is not a git repository, remove it and re-run the setup")
            elif nv_configs.YesNo(
                f"Clone nvscripts repository under {scripts_dir} (also used for global git hooks)?", def_input=True
            ):
                CloneScriptsRepository(scripts_dir, gitaccount, use_pat=use_pat)
        else:
            print(f"### nvscripts repository already exists under {scripts_dir}")
            # Pull latest changes to ensure navona-scripts is up to date
            if RunGit(["-C", scripts_dir, "pull", "--rebase"]) != 0:
                print(f"## Warning: Failed to update navona-scripts in {scripts_dir}")
            else:
                print(f"### Updated navona-scripts to latest version")

        # Install Claude-related files (skills, plugins, etc.) from navona-scripts
        if os.path.isdir(os.path.join(scripts_dir, "claude")):
            if nv_configs.YesNo("Install Claude Code files (skills, plugins) from navona-scripts?", def_input=True):
                InstallClaudeFiles(scripts_dir)
        else:
            print(f"### No Claude files found in {scripts_dir}")

        # Check global git hooks
        hookspath = nv_configs.GetConfig("core.hookspath")
        assert isinstance(hookspath, str) and hookspath != "", f"core.hookspath is not set/bad {hookspath}"
        gitpath = os.path.expanduser(hookspath)
        if not os.path.exists(gitpath):
            # Do not create it under a missing navona-scripts clone: an empty directory there
            # would make the next run believe the repository is already cloned.
            print(f"## Warning: {hookspath} directory does not exist! (clone nvn-scripts)")
        else:
            print(f"### Global git hooks directory {gitpath} exists")

        # Update the prompt with git branch
        UpdatePromptWithGitBranch(nv_configs)

        # Check that the pre-commit hook exists
        if not os.path.exists(os.path.join(gitpath, "navona-tech-pre-commit")):
            print(
                f"## Warning: {os.path.join(gitpath, "navona-tech-pre-commit")} file does not exist! (clone nvn-scripts)"
            )
        else:
            print(f"### Global git hooks file {os.path.join(gitpath, "navona-tech-pre-commit")} exists")

        print("\n### Setup completed successfully.")
        print(f"   - Read {os.path.join(scripts_dir, "README.md")} file for more information.")
        if use_pat:
            print(f"   - GitHub is accessed over HTTPS with your Personal Access Token.")
            print(f"     The token needs at least READ access to {gitaccount}/{scripts_repo} and")
            print(f"     {gitaccount}/{setup_repo}, and READ AND WRITE access to every repository")
            print(f"     you want to work on. Re-run with -u to replace an expired token.")
        else:
            print(f"   - GitHub is accessed over SSH with the {gitkeyname} key.")
        print("")

    except KeyboardInterrupt:
        print("\n### Setup aborted.\n")


if __name__ == "__main__":
    main()
